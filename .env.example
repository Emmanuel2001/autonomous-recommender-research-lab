# Copy to .env and fill in. .env is gitignored; NEVER commit the real file.
#
# The proposer reads TRACK2_LLM_API_KEY first, then falls back to
# GEMINI_API_KEY / GROQ_API_KEY.
TRACK2_LLM_API_KEY=

# ---------------------------------------------------------------------------
# The SCORER's signing key does NOT belong here.
#
# The driver does `set -a && source .env && set +a`, so anything in this file
# ends up in the driver's environment -- and a driver that holds the signing key
# can mint its own ledger entries, which voids the entire tamper-evidence
# argument. Use the key file instead:
#
#     python3 -m core.scorer keygen        # writes secrets/scorer.key, mode 600
#
# It is persisted rather than generated per run. Every experiment script used to
# do `$(openssl rand -hex 32)` and discard it, which made each ledger
# unverifiable the moment the shell exited -- and the ledger is a graded
# deliverable, so "verified once, in a terminal I have since closed" is not
# evidence. The strategy sandbox denies reads of secrets/, so the mutable layer
# cannot reach the key even though it sits on the same filesystem.
# ---------------------------------------------------------------------------

# Optional overrides, normally set per-command rather than here.
#
# TRACK2_LEDGER   which ledger the scorer writes and the watchdog/report follow.
#                 One per experiment, under runs/ledgers/. Never deleted.
# TRACK2_SOCKET   the scorer's unix socket. Set it to run two scorers at once
#                 (e.g. two independent experiments) without them colliding.
# TRACK2_DATA_ROOT  set by core.isolation for the sandboxed strategy. Do not set
#                 by hand: pointing it at the real data directory while
#                 TRACK2_SANDBOX=1 makes load_train_only refuse, on purpose.
# TRACK2_KEY_FILE where the signing key lives (default secrets/scorer.key).
